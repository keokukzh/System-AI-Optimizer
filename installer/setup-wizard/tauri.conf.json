{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3002",
    "distDir": "../src-ui/dist",
    "withGlobalTauri": false,
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:3002"
  },
  "package": {
    "productName": "OptiAI Setup",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.optiai.setup",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "copyright": "© 2024 OptiAI. All rights reserved.",
      "category": "Utility",
      "shortDescription": "OptiAI Installation Setup Wizard",
      "longDescription": "Professional installation wizard for OptiAI System Optimizer",
      "publisher": "OptiAI Team",
      "homepage": "https://github.com/optiai/optiai",
      "repository": "https://github.com/optiai/optiai",
      "license": "MIT",
      "licenseFile": "LICENSE.txt",
      "readme": "README.md",
      "changelog": "CHANGELOG.md",
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.15",
        "exceptionDomain": "",
        "signingIdentity": null,
        "providerShortName": null,
        "entitlements": null
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';",
      "dangerousDisableAssetCspModification": false,
      "dangerousRemoteDomainIpcAccess": []
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "OptiAI Setup Wizard",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": 800,
        "maxHeight": 600,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ]
  }
}
