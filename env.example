# OptiAI Environment Configuration
# Copy this file to .env and update the values as needed

# Backend API Configuration
VITE_API_BASE_URL=http://127.0.0.1:5174
VITE_API_TIMEOUT=30000

# Development Configuration
VITE_DEV_MODE=true
VITE_DEBUG_LOGGING=false

# AI/LLM Configuration
VITE_LLM_SERVER_URL=http://127.0.0.1:11434
VITE_LLM_MODEL=phi3-mini-dev
VITE_LLM_TIMEOUT=60000

# Security Configuration
VITE_ENABLE_VAULT=true
VITE_VAULT_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_AUTOMATION=true
VITE_ENABLE_PROCESS_MANAGEMENT=true
VITE_ENABLE_STARTUP_MANAGEMENT=true
VITE_ENABLE_AI_SUGGESTIONS=true

# External Services
VITE_GITHUB_API_URL=https://api.github.com
VITE_OPTIAI_WEBSITE_URL=https://optiai.com

# Build Configuration
VITE_APP_VERSION=1.0.0
VITE_BUILD_TIMESTAMP=
