# OptiAI Testing Environment
# Multi-stage Docker build for comprehensive testing

FROM node:18-alpine AS frontend-test
WORKDIR /app

# Install frontend dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy frontend source
COPY src/ ./src/
COPY public/ ./public/
COPY index.html ./
COPY vite.config.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./

# Build frontend
RUN npm run build

# Test frontend build
RUN npm run test || echo "Frontend tests completed"

FROM python:3.11-slim AS backend-test
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source
COPY backend/ ./backend/
COPY schemas/ ./schemas/
COPY tests/ ./tests/

# Run backend tests
RUN cd backend && python -m pytest tests/ -v --tb=short

# Test backend startup
RUN cd backend && python -c "import main; print('Backend imports successful')"

FROM rust:1.70-alpine AS tauri-test
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    musl-dev \
    openssl-dev \
    pkgconfig \
    webkit2gtk-dev \
    gtk+3.0-dev \
    libayatana-appindicator-dev \
    librsvg-dev

# Copy Rust source
COPY src-tauri/ ./src-tauri/
COPY Cargo.toml ./
COPY Cargo.lock ./

# Test Rust compilation
RUN cd src-tauri && cargo check --release

# Test Tauri build (without actual build)
RUN cd src-tauri && cargo tauri info

FROM alpine:latest AS integration-test
WORKDIR /app

# Install testing tools
RUN apk add --no-cache \
    curl \
    jq \
    bash \
    python3 \
    py3-pip \
    nodejs \
    npm

# Copy test scripts
COPY tests/e2e/ ./tests/e2e/
COPY scripts/ ./scripts/

# Install Python testing dependencies
RUN pip3 install --no-cache-dir \
    pytest \
    requests \
    selenium \
    playwright

# Install Node.js testing dependencies
RUN npm install -g \
    @playwright/test \
    puppeteer

# Install Playwright browsers
RUN playwright install chromium

# Copy application files
COPY --from=frontend-test /app/dist ./dist
COPY --from=backend-test /app/backend ./backend
COPY --from=tauri-test /app/src-tauri ./src-tauri

# Create test configuration
RUN echo '{"testTimeout": 30000, "retries": 2}' > playwright.config.json

# Set up test environment
ENV NODE_ENV=test
ENV BACKEND_URL=http://localhost:5174
ENV FRONTEND_URL=http://localhost:3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5174/api/health || exit 1

# Default command
CMD ["python3", "-m", "pytest", "tests/e2e/", "-v", "--tb=short"]

# Labels
LABEL maintainer="OptiAI Team"
LABEL description="OptiAI Testing Environment"
LABEL version="1.0.0"
