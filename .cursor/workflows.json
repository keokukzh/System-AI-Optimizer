{
  "workflows": {
    "development": {
      "name": "Development Workflow",
      "description": "Standard development workflow with testing and validation",
      "steps": [
        {
          "name": "pre-commit",
          "type": "hook",
          "actions": [
            "lint-code",
            "format-code",
            "run-tests",
            "security-scan",
            "policy-validation"
          ]
        },
        {
          "name": "build",
          "type": "command",
          "actions": [
            "npm run build",
            "tauri build",
            "validate-build"
          ]
        },
        {
          "name": "test",
          "type": "command",
          "actions": [
            "pytest backend/tests/",
            "npm test",
            "integration-tests"
          ]
        },
        {
          "name": "deploy",
          "type": "command",
          "actions": [
            "create-release",
            "build-installers",
            "update-documentation"
          ]
        }
      ]
    },
    
    "ai-optimization": {
      "name": "AI Optimization Workflow",
      "description": "AI-powered code optimization and suggestions",
      "steps": [
        {
          "name": "analyze",
          "type": "ai",
          "actions": [
            "code-analysis",
            "performance-analysis",
            "security-analysis",
            "maintainability-analysis"
          ]
        },
        {
          "name": "suggest",
          "type": "ai",
          "actions": [
            "optimization-suggestions",
            "refactoring-suggestions",
            "security-improvements",
            "performance-improvements"
          ]
        },
        {
          "name": "implement",
          "type": "ai",
          "actions": [
            "auto-refactor",
            "auto-optimize",
            "auto-secure",
            "validate-changes"
          ]
        }
      ]
    },
    
    "security": {
      "name": "Security Workflow",
      "description": "Comprehensive security validation and scanning",
      "steps": [
        {
          "name": "scan",
          "type": "security",
          "actions": [
            "vulnerability-scan",
            "dependency-scan",
            "code-scan",
            "policy-scan"
          ]
        },
        {
          "name": "validate",
          "type": "security",
          "actions": [
            "policy-compliance",
            "permission-validation",
            "path-validation",
            "action-validation"
          ]
        },
        {
          "name": "report",
          "type": "security",
          "actions": [
            "generate-report",
            "notify-security-team",
            "update-security-log"
          ]
        }
      ]
    },
    
    "performance": {
      "name": "Performance Optimization Workflow",
      "description": "Performance monitoring and optimization",
      "steps": [
        {
          "name": "monitor",
          "type": "performance",
          "actions": [
            "memory-monitoring",
            "cpu-monitoring",
            "disk-monitoring",
            "network-monitoring"
          ]
        },
        {
          "name": "analyze",
          "type": "performance",
          "actions": [
            "bottleneck-analysis",
            "resource-usage-analysis",
            "performance-metrics",
            "optimization-opportunities"
          ]
        },
        {
          "name": "optimize",
          "type": "performance",
          "actions": [
            "auto-optimize",
            "cache-optimization",
            "build-optimization",
            "runtime-optimization"
          ]
        }
      ]
    }
  },
  
  "hooks": {
    "pre-commit": {
      "enabled": true,
      "actions": [
        "lint-code",
        "format-code",
        "run-tests",
        "security-scan"
      ]
    },
    "pre-push": {
      "enabled": true,
      "actions": [
        "integration-tests",
        "build-validation",
        "security-validation"
      ]
    },
    "post-merge": {
      "enabled": true,
      "actions": [
        "dependency-update",
        "cache-clear",
        "rebuild"
      ]
    },
    "pre-build": {
      "enabled": true,
      "actions": [
        "pre-build-check",
        "dependency-check",
        "environment-validation"
      ]
    }
  },
  
  "automation": {
    "dependency-updates": {
      "enabled": true,
      "schedule": "weekly",
      "actions": [
        "check-updates",
        "test-updates",
        "auto-update-safe",
        "notify-team"
      ]
    },
    "security-patches": {
      "enabled": true,
      "schedule": "daily",
      "actions": [
        "scan-vulnerabilities",
        "apply-patches",
        "test-patches",
        "deploy-patches"
      ]
    },
    "performance-monitoring": {
      "enabled": true,
      "schedule": "continuous",
      "actions": [
        "monitor-metrics",
        "detect-anomalies",
        "auto-optimize",
        "alert-team"
      ]
    }
  }
}
