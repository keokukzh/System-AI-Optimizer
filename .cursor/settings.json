{
  "cursor.ai.enabled": true,
  "cursor.ai.model": "claude-3.5-sonnet",
  "cursor.ai.maxTokens": 8192,
  "cursor.ai.temperature": 0.1,
  "cursor.ai.systemPrompt": "You are an expert full-stack developer working on OptiAI, an AI-powered desktop system optimizer. Follow the project's architecture principles, security policies, and coding standards. Always prioritize code quality, security, and maintainability.",
  
  "cursor.ai.features": {
    "codeCompletion": true,
    "codeGeneration": true,
    "codeReview": true,
    "refactoring": true,
    "documentation": true,
    "testing": true,
    "debugging": true
  },
  
  "cursor.ai.context": {
    "includeProjectFiles": true,
    "includeGitHistory": true,
    "includeDocumentation": true,
    "maxContextFiles": 50,
    "contextWindow": 100000
  },
  
  "cursor.ai.workflows": {
    "autoFormat": true,
    "autoLint": true,
    "autoTest": true,
    "autoCommit": false,
    "autoDeploy": false
  },
  
  "cursor.ai.security": {
    "validateActions": true,
    "checkPolicyCompliance": true,
    "scanForVulnerabilities": true,
    "requireApproval": false
  },
  
  "cursor.ai.performance": {
    "monitorMemory": true,
    "trackPerformance": true,
    "optimizeBuilds": true,
    "cacheResults": true
  },
  
  "cursor.ai.integrations": {
    "github": true,
    "gitlab": false,
    "jira": false,
    "slack": false,
    "telegram": false
  },
  
  "cursor.ai.notifications": {
    "buildStatus": true,
    "testResults": true,
    "securityAlerts": true,
    "performanceWarnings": true,
    "errorReports": true
  },
  
  "cursor.ai.automation": {
    "dependencyUpdates": true,
    "securityPatches": true,
    "codeQualityChecks": true,
    "performanceOptimization": true,
    "documentationUpdates": true
  },
  
  "cursor.ai.tools": {
    "testingSuite": true,
    "projectManagement": true,
    "devopsAutomation": true,
    "aiMlToolkit": true,
    "performanceOptimizer": true,
    "securityPro": true,
    "gitWorkflow": true
  }
}
