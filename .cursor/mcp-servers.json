{
  "mcpServers": {
    "devtools": {
      "context7": {
        "command": "npx",
        "args": ["@context7/cli", "serve"],
        "env": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}",
          "CONTEXT7_PROJECT_ID": "optiai"
        },
        "description": "Context7 documentation and API reference server"
      },
      "markitdown": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-markitdown"],
        "description": "Markdown processing and conversion server"
      },
      "just-mcp": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-just"],
        "description": "Just-in-time MCP server for dynamic operations"
      }
    },
    
    "browser-automation": {
      "playwright": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-playwright"],
        "env": {
          "PLAYWRIGHT_BROWSERS_PATH": "./node_modules/playwright/.local-browsers"
        },
        "description": "Playwright browser automation server"
      },
      "browser-use": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-browser-use"],
        "description": "Browser automation with natural language commands"
      }
    },
    
    "integration": {
      "github": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-github"],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
        },
        "description": "GitHub integration server"
      },
      "memory": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-memory"],
        "description": "Memory and context management server"
      }
    },
    
    "web": {
      "fetch": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-fetch"],
        "description": "Web content fetching and processing server"
      }
    },
    
    "database": {
      "postgresql": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-postgres"],
        "env": {
          "POSTGRES_CONNECTION_STRING": "${POSTGRES_CONNECTION_STRING}"
        },
        "description": "PostgreSQL database integration server"
      },
      "mysql": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-mysql"],
        "env": {
          "MYSQL_CONNECTION_STRING": "${MYSQL_CONNECTION_STRING}"
        },
        "description": "MySQL database integration server"
      }
    },
    
    "filesystem": {
      "filesystem-access": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-filesystem"],
        "env": {
          "ALLOWED_PATHS": "./src,./backend,./scripts"
        },
        "description": "Filesystem access and manipulation server"
      }
    },
    
    "deepgraph": {
      "nextjs": {
        "command": "npx",
        "args": ["@deepgraph/mcp-server-nextjs"],
        "description": "DeepGraph Next.js integration server"
      },
      "react": {
        "command": "npx",
        "args": ["@deepgraph/mcp-server-react"],
        "description": "DeepGraph React integration server"
      },
      "vue": {
        "command": "npx",
        "args": ["@deepgraph/mcp-server-vue"],
        "description": "DeepGraph Vue.js integration server"
      }
    },
    
    "marketing": {
      "google-ads": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-google-ads"],
        "env": {
          "GOOGLE_ADS_API_KEY": "${GOOGLE_ADS_API_KEY}",
          "GOOGLE_ADS_CLIENT_ID": "${GOOGLE_ADS_CLIENT_ID}"
        },
        "description": "Google Ads API integration server"
      },
      "facebook-ads": {
        "command": "npx",
        "args": ["@modelcontextprotocol/server-facebook-ads"],
        "env": {
          "FACEBOOK_ADS_API_KEY": "${FACEBOOK_ADS_API_KEY}",
          "FACEBOOK_ADS_ACCOUNT_ID": "${FACEBOOK_ADS_ACCOUNT_ID}"
        },
        "description": "Facebook Ads API integration server"
      }
    }
  },
  
  "serverConfig": {
    "timeout": 30000,
    "retries": 3,
    "healthCheck": true,
    "logging": {
      "level": "info",
      "file": ".cursor/mcp-servers.log"
    },
    "security": {
      "allowedOrigins": ["http://localhost:3001", "http://localhost:5174", "tauri://localhost"],
      "requireAuth": false,
      "rateLimit": {
        "requests": 100,
        "window": 60000
      }
    }
  },
  
  "workflows": {
    "startup": [
      "devtools/context7",
      "integration/memory",
      "filesystem/filesystem-access"
    ],
    "development": [
      "devtools/context7",
      "devtools/markitdown",
      "integration/github",
      "browser-automation/playwright"
    ],
    "testing": [
      "browser-automation/playwright",
      "browser-automation/browser-use",
      "integration/memory"
    ],
    "deployment": [
      "integration/github",
      "web/fetch",
      "devtools/context7"
    ]
  }
}
