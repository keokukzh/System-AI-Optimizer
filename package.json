{
  "name": "optiai",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered desktop system optimization tool",
  "main": "src/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --reporter=verbose src/tests/",
    "test:integration": "vitest run --reporter=verbose tests/",
    "test:backend": "cd backend && python -m pytest tests/ -v",
    "test:backend:coverage": "cd backend && python -m pytest tests/ --cov=backend --cov-report=html",
    "test:tauri": "cd src-tauri && cargo test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:backend && npm run test:tauri",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src/ --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "security:scan": "node .cursor/tools/security-pro.js",
    "performance:analyze": "node .cursor/tools/performance-optimizer.js",
    "project:init": "node .cursor/tools/project-management.js init",
    "project:analyze": "node .cursor/tools/project-management.js analyze",
    "workflow:list": "node .cursor/automation/workflow-orchestrator.js list",
    "workflow:dev": "node .cursor/automation/workflow-orchestrator.js execute development",
    "git:status": "node .cursor/automation/git-workflow.js status",
    "git:feature": "node .cursor/automation/git-workflow.js feature",
    "git:release": "node .cursor/automation/git-workflow.js release",
    "setup:cursor": "node .cursor/setup.js",
    "mcp:start": ".cursor/start-mcp-servers.bat",
    "ci": "npm run lint && npm run type-check && npm run test:run && npm run build",
    "ci:full": "npm run ci && npm run test:backend && npm run test:tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.294.0",
    "react": "^19.2.0",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.0.0",
    "vite": "^4.5.14",
    "vitest": "^1.0.0"
  }
}
