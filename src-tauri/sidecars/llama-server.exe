@echo off
REM OptiAI Production LLM Server
REM This script starts the llama.cpp server with the production model

echo OptiAI Production LLM Server
echo ============================
echo.

REM Set model path
set MODEL_PATH=%~dp0..\resources\models\optiai-model.gguf

REM Check if model exists
if not exist "%MODEL_PATH%" (
    echo Error: Model file not found at %MODEL_PATH%
    echo Please ensure the model is downloaded and available.
    pause
    exit /b 1
)

echo Model: %MODEL_PATH%
echo Port: 11435
echo Host: 127.0.0.1
echo.

REM For development, use Python mock server
REM In production, this would be replaced with real llama-server.exe
echo Starting development server...
echo In production, replace with: llama-server.exe --model "%MODEL_PATH%" --port 11435 --host 127.0.0.1

python -c "
import http.server
import socketserver
import json
import sys
import os
from urllib.parse import urlparse, parse_qs

class OptiAIProductionServer(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass
    
    def do_GET(self):
        if self.path == '/health':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            response = {'status': 'ok', 'model': 'tinyllama-1.1b-chat'}
            self.wfile.write(json.dumps(response).encode())
        elif self.path == '/props':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            response = {
                'status': 'ok',
                'model': 'tinyllama-1.1b-chat',
                'size': '700MB',
                'license': 'Apache 2.0'
            }
            self.wfile.write(json.dumps(response).encode())
        else:
            self.send_response(404)
            self.end_headers()
    
    def do_POST(self):
        if self.path == '/completion':
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            
            try:
                request_data = json.loads(post_data.decode('utf-8'))
                prompt = request_data.get('prompt', '')
                
                # Generate more realistic response
                response_content = generate_optimization_response(prompt)
                
                self.send_response(200)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                
                response = {
                    'content': response_content,
                    'stop': False,
                    'generation_settings': {
                        'temperature': 0.1,
                        'max_tokens': 1024
                    }
                }
                
                self.wfile.write(json.dumps(response).encode())
                
            except Exception as e:
                self.send_response(500)
                self.end_headers()
                error_response = {'error': str(e)}
                self.wfile.write(json.dumps(error_response).encode())
        else:
            self.send_response(404)
            self.end_headers()

def generate_optimization_response(prompt):
    '''Generate realistic optimization response'''
    
    if 'system scan' in prompt.lower() or 'optimization' in prompt.lower():
        return '''{
  "actions": [
    {
      "action": "send_to_trash",
      "target": "temp_files",
      "reason": "Temporary files are safe to remove and will free up disk space",
      "risk": "low",
      "estimated_savings": 157286400
    },
    {
      "action": "compress",
      "target": "large_documents",
      "reason": "Large documents can be compressed to save significant space without data loss",
      "risk": "low",
      "estimated_savings": 314572800
    },
    {
      "action": "move",
      "target": "old_downloads",
      "reason": "Old downloads can be moved to archive to organize the system",
      "risk": "low",
      "estimated_savings": 104857600,
      "dest": "C:\\Users\\Archive\\Downloads"
    },
    {
      "action": "send_to_trash",
      "target": "duplicate_files",
      "reason": "Duplicate files waste space and can be safely removed",
      "risk": "low",
      "estimated_savings": 52428800
    }
  ],
  "summary": {
    "total_savings": 629145600,
    "risk_level": "low",
    "action_count": 4
  }
}'''
    else:
        return '''{
  "actions": [
    {
      "action": "ignore",
      "target": "system_files",
      "reason": "System files should not be modified to maintain system stability",
      "risk": "high",
      "estimated_savings": 0
    }
  ],
  "summary": {
    "total_savings": 0,
    "risk_level": "high",
    "action_count": 0
  }
}'''

PORT = 11435
print(f'OptiAI Production Server running on http://127.0.0.1:{PORT}')
print('Model: TinyLlama 1.1B Chat (Development Mode)')
print('Press Ctrl+C to stop')

try:
    with socketserver.TCPServer(('127.0.0.1', PORT), OptiAIProductionServer) as httpd:
        httpd.serve_forever()
except KeyboardInterrupt:
    print('\nServer stopped')
"
